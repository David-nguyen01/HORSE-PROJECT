DB_URL=jdbc:sqlserver://racehorse-training-management.database.windows.net:1433;databaseName=racehorse;encrypt=true;trustServerCertificate=true
DB_USERNAME=racehorse_admin
DB_PASSWORD=replace-with-azure-sql-password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ISSUER=racehorse-backend
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=racehorse
