DB_URL=jdbc:sqlserver://your-sql-host:1433;databaseName=racehorse;encrypt=true;trustServerCertificate=false
DB_USERNAME=replace-with-app-sql-user
DB_PASSWORD=replace-with-azure-sql-password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://your-frontend-host
JWT_ISSUER=racehorse-backend
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=racehorse
PAYOS_GATEWAY=fake
PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=https://your-frontend-host/wallet
PAYOS_CANCEL_URL=https://your-frontend-host/wallet
VNPAY_TMN_CODE=replace-with-vnpay-sandbox-terminal-id
VNPAY_HASH_SECRET=replace-with-vnpay-sandbox-hash-secret
