DB_URL=jdbc:sqlserver://your-sql-host:1433;databaseName=racehorse;encrypt=true;trustServerCertificate=false
DB_USERNAME=replace-with-app-sql-user
DB_PASSWORD=replace-with-azure-sql-password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://your-frontend-host
JWT_ISSUER=racehorse-backend
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=racehorse

# Payment Gateway (VNPAY is the only supported gateway)
PAYOS_GATEWAY=vnpay

# VNPAY Configuration (Sandbox defaults shown; replace with merchant credentials)
# Terminal ID provided by VNPAY
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
# Hash Secret key provided by VNPAY (used for HMAC-SHA512 checksum)
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
# Gateway URL:
# - Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# - Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Frontend return URL where users are redirected after payment
VNPAY_RETURN_URL=https://your-frontend-host/wallet
