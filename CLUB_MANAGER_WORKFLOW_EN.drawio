        <mxCell id="p3_31" value="BUSINESS RULES &amp; TECHNICAL CONSTRAINTS: OWNERSHIP &amp; SERVICE OVERRIDE RULES" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#2563EB;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1000" width="1780" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3_32" value="1. Single Owner Invariant: Database enforces ux_horse_ownerships_one_owner ensuring exactly 1 active owner with 100% share per horse.&#10;2. Service Override Semantics: Setting service_override = 1 allows a horse to enter medical examination and stabling without wallet deduction. It does NOT create fictitious revenue.&#10;3. Revocation: If override is cancelled, the horse is immediately flagged as unpaid upon next billing cycle." style="text;html=0;fontSize=12;fontStyle=0;fontColor=#0F172A;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="70" y="1025" width="1780" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
