        <mxCell id="p1_44" value="BUSINESS RULES &amp; TECHNICAL CONSTRAINTS: SECURITY CONSTRAINTS &amp; HANDOVER ENFORCEMENT" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#D97706;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1000" width="1780" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1_45" value="1. AccountActivityGuard: System prevents deactivating or re-roling accounts actively linked to live horses (current_trainer_id, diagnosing_vet_user_id, caretaker_user_id, horse_ownerships).&#10;2. Token Eviction: Disabling an account immediately invalidates outstanding JWT refresh tokens, preventing API calls upon next token refresh.&#10;3. Re-enabling: Setting enabled = true allows login again but does NOT restore previous expired tokens." style="text;html=0;fontSize=12;fontStyle=0;fontColor=#0F172A;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="70" y="1025" width="1780" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
