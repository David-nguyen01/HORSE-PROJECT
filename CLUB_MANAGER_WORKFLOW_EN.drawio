        <mxCell id="p7_29" value="BUSINESS RULES &amp; TECHNICAL CONSTRAINTS: TRANSACTIONAL BOUNDARY &amp; EXPENSE RECONCILIATION" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#2563EB;align=left;verticalAlign=middle;" parent="1" vertex="1">
