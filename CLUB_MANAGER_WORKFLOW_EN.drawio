        <mxCell id="p6_32" value="BUSINESS RULES &amp; TECHNICAL CONSTRAINTS: APPROVAL AND RECEIPT INTEGRITY" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#2563EB;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1000" width="1780" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p6_33" value="1. Exclusive Approval Authority: Only users holding ROLE_CLUB_MANAGER are authorized to approve or reject replenishment requests.&#10;2. Double-Increment Protection: The receipt handler strictly verifies status == 'APPROVED' prior to incrementing stock_quantity, preventing duplicate stock booking.&#10;3. Financial Boundary: Goods receipt increases physical stock; it does NOT automatically book accounting expenses until stock is consumed in Flow 07." style="text;html=0;fontSize=12;fontStyle=0;fontColor=#0F172A;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="70" y="1025" width="1780" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
