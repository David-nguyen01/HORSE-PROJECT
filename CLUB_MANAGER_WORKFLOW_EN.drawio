        <mxCell id="p10_32" value="BUSINESS RULES &amp; TECHNICAL CONSTRAINTS: DATABASE TRIGGER GUARD: TR_AUDIT_LOGS_APPEND_ONLY" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#D97706;align=left;verticalAlign=middle;" parent="1" vertex="1">
